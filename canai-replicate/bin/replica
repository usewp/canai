#!/usr/bin/env node
import { argv, exit, stderr } from "node:process";
import { pathToFileURL } from "node:url";
import path from "node:path";
import { readRunConfig, writeRunConfig, requireRunConfig, runConfigPath, OBJECTIVES, resolveObjective } from "../src/runConfig.mjs";
import { seedPageModeWorklist } from "../src/pageCapture.mjs";
import { urlToSlug } from "../src/slug.mjs";
import { discover } from "../src/discover.mjs";
import { classify } from "../src/classify.mjs";
import { prepareDesignBundle } from "../src/designmd.mjs";
import { prepareContentModelBundle } from "../src/contentmodel.mjs";
import { prepareTransformBundles } from "../src/transform.mjs";
import { preparePushArtifacts } from "../src/pushprep.mjs";
import { verifyScore, verifyBundle } from "../src/verify.mjs";
import { verifyPage, verifyPageBundle } from "../src/verifyPage.mjs";
import { runHandoffPage } from "../src/handoffPage.mjs";
import { DEFAULT_PAGE_GATE } from "../src/pageGate.mjs";

function parseArgs(rest) {
  const out = { _: [] };
  for (let i = 0; i < rest.length; i++) {
    const a = rest[i];
    if (a.startsWith("--")) {
      const k = a.slice(2);
      const next = rest[i + 1];
      if (next != null && !next.startsWith("--")) {
        out[k] = next;
        i++;
      } else {
        out[k] = true;
      }
    } else {
      out._.push(a);
    }
  }
  return out;
}

// Fix 1b: a stage that produced NOTHING must never report success. Before
// this, `capture` printing "✓ 0/10 pages captured" with exit code 0 on a
// total failure was proven live (see .superpowers/sdd/dogfood-a1-report.md
// — a Chrome crash cascaded through the whole worklist, and the CLI still
// exited clean) — no calling script or CI could ever detect it. Pure:
// decides the ✓/✗ marker and whether `succeeded` out of `total` counts as a
// total failure, for any stage shaped like "N attempted, M succeeded"
// (capture, verify). Partial success (0 < succeeded < total) stays a
// success but the summary must plainly show the failure count, not just an
// implicit ratio a human has to subtract themselves.
export function summarizeCountOutcome(succeeded, total) {
  const failed = total - succeeded;
  const mark = succeeded > 0 ? "✓" : "✗";
  const failedSuffix = succeeded > 0 && failed > 0 ? ` (${failed} failed)` : "";
  return { mark, failed, failedSuffix, isTotalFailure: succeeded === 0 };
}

// classify's typeCount/pageCount don't fit the succeeded/total shape above:
// 0 types with N one-off pages is a perfectly normal, expected result (a
// site with no repeating content type at all — proven live in the same
// dogfood run), not a failure. Only "found NEITHER a type NOR a single
// page" means classify genuinely had nothing to work with (e.g. an empty
// pages.json).
export function classifyProducedNothing(typeCount, pageCount) {
  return typeCount === 0 && pageCount === 0;
}

// transform.mjs already throws when `--only` matches nothing, but a full
// (no --only) run that simply has zero one-off pages and zero types to
// bundle — e.g. everything got dropped by resolveSlugClaims, or the site is
// otherwise empty — currently returns success with count: 0. `chrome` is
// tracked separately from `count`/`bundles` (see transform.mjs's own doc
// comment on why), so it must be checked too: a chrome-only run (`--only
// chrome`) that DOES produce header/footer must not be flagged as having
// produced nothing.
export function transformProducedNothing(count, hasChrome) {
  return count === 0 && !hasChrome;
}

/**
 * Resolve capture `--page`. Absent → null (full-site). A bare `--page` with
 * no URL string must fail loud — never silently fall into full-site capture.
 */
export function resolveCapturePageUrl(pageArg) {
  if (pageArg === undefined || pageArg === null || pageArg === false) return null;
  if (typeof pageArg === "string" && pageArg.trim()) return pageArg.trim();
  throw new Error("usage: capture <site> --page <url>  (--page requires a URL)");
}

const HELP = `replica — migrate any website to semantic single-HTML files

USAGE
  replica <command> <args> [flags]

COMMANDS
  objective    <site>  Record what this run is for — required before transform/verify
                       --set <structure|wireframe|styled|pixel> [--scope site|page]
                       → runs/<site>/run.json  (no --set: print the current value)
  discover  <url>            Find pages (sitemap or crawl). Writes runs/<site>/pages.json
  classify  <site>           Cluster pages into page types. Writes runs/<site>/pagetypes.json + .classify/PROMPT.md
  capture   <site>           Write the agent-browser capture bundle → runs/<site>/.capture/PROMPT.md (YOU run it)
  slice     <site>           Cut full-page screenshots into per-section PNGs
  check     <site>           Validate capture artifacts (decodes PNGs; blank slices fail)
  designmd  <site>           Prepare bundle + prompt for design-md skill
  contentmodel <site>        Prepare CPT/custom-field handoff bundle → agent writes runs/<site>/CONTENT-MODEL.md
  transform <site>           Prepare per-page/per-type bundles + prompts; agent writes runs/<site>/output/pages/<slug>.html or output/templates/<type>-single.html
  pushprep  <site>           Convert output/pages + output/templates into push-ready runs/<site>/output/push/<slug>.json (strips the doctype/head/body shell + preview-libs). NEVER push a raw output/pages|templates/*.html file into _canai_html — push the output/push/ artifact instead.
  verify    <site>           Write the agent-browser screenshot bundle → runs/<site>/.verify/PROMPT.md (YOU run it)
  verify-score <site>        Pixel-score the screenshots, write report.md
  verify-page <site>         Write the page-mode screenshot bundle (requires --only <slug>)
  verify-page-score <site>   Page-mode dual full-page hard gate (requires --only <slug>)
  handoff-page <site>        After page-report pass: swap inline chrome→Twig, pushprep (requires --only <slug>)

FLAGS
  --runs <dir>               Output root (default: runs)
  --profile <path>           agent-browser Chrome profile dir (recommended: "$HOME/.canai-browser")
  --session <name>           agent-browser session name (default: canai)
  --only <path|slug|type>    Restrict to one page (URL pathname or slug) or one page type (type name)
  --page <url>               (capture) Page-mode: capture one URL at dual widths (1440/390)
  --page-mode                (transform) Page-mode static fidelity draft (inline chrome, transform-page.md)
  --max-mismatch <n>         (verify-page) Max mismatch % before fail (default: ${DEFAULT_PAGE_GATE.maxMismatchPct})
  --max-height-delta <n>     (verify-page) Max height delta % before fail (default: ${DEFAULT_PAGE_GATE.maxHeightDeltaPct})
  --max-attempts <n>         (verify-page) Attempts before hard fail (default: ${DEFAULT_PAGE_GATE.maxAttempts})
  --min-severity-improvement <n>
                             (verify-page) Min combined-severity drop between failed attempts or stagnate-fail (default: ${DEFAULT_PAGE_GATE.minSeverityImprovement})

EXAMPLES
  replica discover  https://example.com/
  replica capture   example.com --profile "$HOME/.canai-browser"
  replica slice     example.com
  replica check     example.com
  replica designmd  example.com
  replica contentmodel example.com
  replica transform example.com --only /
  replica transform example.com --page-mode --only pricing
  replica pushprep  example.com
  replica verify    example.com
  replica verify-score example.com
  replica verify-page example.com --only pricing
  replica verify-page-score example.com --only pricing
  replica handoff-page example.com --only pricing
`;

async function main() {
  const [, , cmd, ...rest] = argv;
  if (!cmd || cmd === "-h" || cmd === "--help") {
    stderr.write(HELP);
    exit(cmd ? 0 : 1);
  }
  const args = parseArgs(rest);
  const runsDir = args.runs || "runs";
  const session = args.session || "canai";
  const profile = args.profile || null;
  let only = args.only || null;

  switch (cmd) {
    case "objective": {
      const site = args._[0];
      if (!site) throw new Error(`usage: objective <site> [--set <${OBJECTIVES.join("|")}>] [--scope site|page]`);
      const runDir = path.join(runsDir, site);
      if (args.set != null) {
        if (args.set === true) throw new Error(`--set requires a value: ${OBJECTIVES.join("|")}`);
        const scope = args.scope != null ? String(args.scope) : "site";
        const { config, previous } = await writeRunConfig(runDir, { objective: String(args.set), scope });
        const was = previous ? ` (was ${previous.objective}/${previous.scope})` : "";
        stderr.write(`✓ ${site}: objective=${config.objective} scope=${config.scope}${was} → ${runConfigPath(runDir)}\n`);
      } else {
        const c = await requireRunConfig(runDir, { site });
        stderr.write(`${site}: objective=${c.objective} scope=${c.scope} (set ${c.setAt} by ${c.setBy})\n`);
      }
      break;
    }
    case "discover": {
      const url = args._[0];
      if (!url) throw new Error("usage: discover <url>");
      const r = await discover(url, runsDir);
      const mark = r.count > 0 ? "✓" : "✗";
      stderr.write(`${mark} ${r.site}: ${r.count} pages (${r.source}) → ${r.outPath}\n`);
      if (r.count === 0) {
        throw new Error(`discover found 0 pages for ${r.site} (source: ${r.source}) — nothing for the rest of the pipeline to work with`);
      }
      break;
    }
    case "classify": {
      const site = args._[0];
      if (!site) throw new Error("usage: classify <site>");
      const r = await classify({ site, runsDir });
      const mark = classifyProducedNothing(r.typeCount, r.pageCount) ? "✗" : "✓";
      stderr.write(
        `${mark} ${r.typeCount} type(s), ${r.pageCount} one-off page(s) → ${r.outPath}\n` +
          `\nNext: have a coding agent review the classification:\n\n  ${r.promptPath}\n`,
      );
      if (classifyProducedNothing(r.typeCount, r.pageCount)) {
        throw new Error(`classify produced 0 types and 0 pages for ${site} — nothing to classify (is pages.json empty?)`);
      }
      break;
    }
    case "capture": {
      const site = args._[0];
      if (!site) throw new Error("usage: capture <site> [--page <url>]");
      const pageUrl = resolveCapturePageUrl(args.page);
      if (pageUrl) {
        const runDir = path.join(runsDir, site);
        await seedPageModeWorklist(runDir, { site, url: pageUrl });
        if (!(await readRunConfig(runDir))) {
          await writeRunConfig(runDir, { objective: "pixel", scope: "page", setBy: "capture-page" });
          stderr.write(`  run.json seeded: objective=pixel scope=page (change with: replica objective ${site} --set <objective>)\n`);
        }
        only = only || urlToSlug(pageUrl);
      }
      const { captureBundle } = await import("../src/captureBundle.mjs");
      const r = await captureBundle({ site, runsDir, only, profile, session });
      stderr.write(`✓ capture bundle for ${r.count} page(s) → ${r.promptPath}\n`);
      stderr.write(`  run it with agent-browser, then: replica slice ${site} && replica check ${site}\n`);
      break;
    }
    case "slice": {
      const site = args._[0];
      if (!site) throw new Error("usage: slice <site> [--only <slug>]");
      const { slice } = await import("../src/slice.mjs");
      const r = await slice({ site, runsDir, only });
      // NOT summarizeCountOutcome(r.ok, ...): that helper takes (succeeded,
      // total) as NUMBERS. slice has no partial-success state — a viewport
      // either slices or is skipped — so a plain zero check is the honest one.
      if (r.count === 0) {
        throw new Error(
          `slice produced 0 section sets — no capture has both a full-page PNG and section metadata (run capture first)`,
        );
      }
      const pngCount = r.slices.reduce((n, s) => n + s.written, 0);
      stderr.write(`✓ sliced ${r.count} section set(s), ${pngCount} PNG(s)\n`);
      break;
    }
    case "check": {
      const site = args._[0];
      if (!site) throw new Error("usage: check <site> [--only <slug>]");
      const { check } = await import("../src/check.mjs");
      const r = await check({ site, runsDir, only });
      for (const res of r.results) {
        for (const w of res.warnings) stderr.write(`  ! ${res.slug}: ${w}\n`);
        for (const e of res.errors) stderr.write(`  ✗ ${res.slug}: ${e}\n`);
      }
      if (r.total === 0) {
        throw new Error(`check found no capture directories under runs/${site}/captures`);
      }
      stderr.write(`${r.ok ? "✓" : "✗"} ${r.count}/${r.total} capture(s) valid\n`);
      if (!r.ok) {
        throw new Error(
          `check failed for ${r.total - r.count} capture(s) — see the per-capture reasons above`,
        );
      }
      break;
    }
    case "designmd": {
      const site = args._[0];
      if (!site) throw new Error("usage: designmd <site>");
      const r = await prepareDesignBundle({ site, runsDir });
      stderr.write(
        `✓ design bundle ready (${r.picked.length} pages: ${r.picked.join(", ")})\n` +
          `\nNext: have a coding agent run the prompt:\n\n  ${r.promptPath}\n\n` +
          `It should produce: ${r.designMdPath}\n`,
      );
      break;
    }
    case "contentmodel": {
      const site = args._[0];
      if (!site) throw new Error("usage: contentmodel <site>");
      const r = await prepareContentModelBundle({ site, runsDir });
      stderr.write(
        `✓ content-model bundle ready (${r.typeCount} type(s))\n` +
          `\nNext: have a coding agent run the prompt:\n\n  ${r.promptPath}\n\n` +
          `It should produce: ${r.contentModelPath}\n`,
      );
      break;
    }
    case "transform": {
      const site = args._[0];
      if (!site) throw new Error("usage: transform <site> [--only <slug>]  (objective comes from run.json; --page-mode = pixel alias)");
      const runDir = path.join(runsDir, site);
      const pageModeFlag = !!args["page-mode"];
      let runConfig = await readRunConfig(runDir);
      if (!runConfig && pageModeFlag) {
        ({ config: runConfig } = await writeRunConfig(runDir, { objective: "pixel", scope: "page", setBy: "page-mode-flag" }));
      }
      if (!runConfig) runConfig = await requireRunConfig(runDir, { site });
      const objective = resolveObjective({ runConfig, pageModeFlag });
      const pageMode = objective === "pixel";
      const r = await prepareTransformBundles({ site, runsDir, only, objective });
      if (r.chrome) {
        stderr.write(
          `  chrome (site-wide header/footer, from ${r.chrome.sourceCapture})\n` +
            `    prompt: ${r.chrome.promptPath}\n    header output: ${r.chrome.outputPath}\n` +
            `    footer output: ${r.chrome.footerOutputPath}\n`,
        );
      }
      const transformNothing = transformProducedNothing(r.count, !!r.chrome);
      const modeNote = ` (objective: ${objective})`;
      stderr.write(`${transformNothing ? "✗" : "✓"} ${r.count} transform bundle(s) ready${modeNote}:\n`);
      for (const b of r.bundles) {
        stderr.write(`  ${b.slug}\n${b.promptPath ? `    prompt: ${b.promptPath}\n` : ""}    output: ${b.outputPath}\n`);
        if (b.archiveOutputPath) {
          stderr.write(`    archive output: ${b.archiveOutputPath}\n`);
        }
      }
      if (pageMode) {
        stderr.write(
          `\nHand each PROMPT.md to a coding agent to produce the static fidelity draft (inline chrome). ` +
            `After verify-page passes, run handoff-page (requires chrome via \`transform --only chrome\` first).\n`,
        );
      } else {
        stderr.write(`\nHand each PROMPT.md to a coding agent (claudecode/cursor/gemini) to produce the output HTML — chrome first, so header.html/footer.html exist before the others are authored against them.\n`);
      }
      if (transformNothing) {
        throw new Error(`transform produced 0 bundles for ${site} — nothing to hand to a coding agent`);
      }
      break;
    }
    case "pushprep": {
      const site = args._[0];
      if (!site) throw new Error("usage: pushprep <site>");
      const r = await preparePushArtifacts({ site, runsDir, only });
      const { mark, failedSuffix, isTotalFailure } = summarizeCountOutcome(r.ok, r.count);
      stderr.write(`${mark} ${r.ok}/${r.count} file(s) converted${failedSuffix} → ${r.outDir}\n`);
      if (r.failures.length > 0) {
        stderr.write(`\nFailed conversions (never silently skipped):\n`);
        for (const f of r.failures) {
          stderr.write(`  ✗ ${f.file}\n    ${f.errors.join("\n    ")}\n`);
        }
      }
      stderr.write(`\nPush the output/push/*.json artifacts to WordPress — NEVER write a raw output/pages|templates/*.html file into _canai_html (doubles WPCanAI's own document shell around it; see dogfood A2 Defect #1).\n`);
      if (isTotalFailure) {
        throw new Error(`pushprep converted 0/${r.count} files for ${site} — see the per-file errors above`);
      }
      break;
    }
    case "verify": {
      const site = args._[0];
      if (!site) throw new Error("usage: verify <site>");
      const r = await verifyBundle({ site, runsDir, only, profile, session });
      stderr.write(`✓ verify bundle for ${r.count} output(s) → ${r.promptPath}\n`);
      stderr.write(`  run it with agent-browser, then: replica verify-score ${site}\n`);
      break;
    }
    case "verify-score": {
      const site = args._[0];
      if (!site) throw new Error("usage: verify-score <site>");
      const r = await verifyScore({ site, runsDir, only });
      const { mark, failedSuffix, isTotalFailure } = summarizeCountOutcome(r.ok, r.count);
      // Fix (final review): current-generation output almost always includes
      // the shared {{ wpcanai_template('header') }}/footer chrome (see
      // prompts/transform.md), so "N/N pages rendered" alone reads as
      // success even when the pixel-scored table is empty. Report the
      // screenshot count and the scored count separately, and say WHY when
      // nothing was scored, instead of implying a clean pass.
      const twigNote = r.twig > 0 ? ` (${r.twig} contain Twig — verify after deploy)` : "";
      stderr.write(
        `${mark} ${r.ok}/${r.count} screenshotted${failedSuffix}, ${r.scored} pixel-scored${twigNote} → ${r.manifestPath}\n  report: ${r.reportPath}\n`,
      );
      if (isTotalFailure) {
        throw new Error(`verify produced 0/${r.count} successfully screenshotted pages — see ${r.reportPath} for detail`);
      }
      break;
    }
    case "verify-page": {
      const site = args._[0];
      if (!site || !only) throw new Error("usage: verify-page <site> --only <slug>");
      const r = await verifyPageBundle({ site, runsDir, only, profile, session });
      stderr.write(`✓ page-verify bundle for ${r.slug} → ${r.promptPath}\n`);
      stderr.write(`  run it with agent-browser, then: replica verify-page-score ${site} --only ${r.slug}\n`);
      break;
    }
    case "verify-page-score": {
      const site = args._[0];
      if (!site || !only) throw new Error("usage: verify-page-score <site> --only <slug>");
      const thresholds = {};
      if (args["max-mismatch"] != null) thresholds.maxMismatchPct = Number(args["max-mismatch"]);
      if (args["max-height-delta"] != null) thresholds.maxHeightDeltaPct = Number(args["max-height-delta"]);
      if (args["max-attempts"] != null) thresholds.maxAttempts = Number(args["max-attempts"]);
      if (args["min-severity-improvement"] != null) {
        thresholds.minSeverityImprovement = Number(args["min-severity-improvement"]);
      }
      const r = await verifyPage({ site, runsDir, only, thresholds });
      const mark = r.status === "pass" ? "✓" : r.status === "fail" ? "✗" : "…";
      stderr.write(
        `${mark} verify-page ${r.slug}: status=${r.status} (attempt ${r.attempts})` +
          `${r.canHandoff ? " — ready for handoff-page" : ""}\n` +
          `  report: ${runsDir}/${site}/verify/page-report.json\n`,
      );
      break;
    }
    case "handoff-page": {
      const site = args._[0];
      if (!site || !only) throw new Error("usage: handoff-page <site> --only <slug>");
      const r = await runHandoffPage({ site, runsDir, only });
      const { mark, failedSuffix, isTotalFailure } = summarizeCountOutcome(r.ok, r.count);
      stderr.write(
        `${mark} handoff-page ${r.slug}: chrome→Twig, backup ${r.backupPath}\n` +
          `${mark} ${r.ok}/${r.count} push artifact(s)${failedSuffix} → ${r.outDir}\n`,
      );
      if (r.failures.length > 0) {
        stderr.write(`\nFailed conversions:\n`);
        for (const f of r.failures) {
          stderr.write(`  ✗ ${f.file}\n    ${f.errors.join("\n    ")}\n`);
        }
      }
      if (isTotalFailure) {
        throw new Error(`handoff-page pushprep converted 0/${r.count} files for ${site}`);
      }
      break;
    }
    default:
      stderr.write(`unknown command: ${cmd}\n${HELP}`);
      exit(1);
  }
}

// Only auto-run when this file is executed directly (`node bin/replica ...`
// / the shebang), never when imported — e.g. by bin/replica.test.mjs, which
// imports the pure helpers above (summarizeCountOutcome/
// classifyProducedNothing/transformProducedNothing) for direct unit
// testing. Without this guard, importing this file would call main()
// against whatever process.argv the IMPORTING process happens to have
// (a test runner's own argv, not a replica command) and process.exit()
// before the import even resolves — taking the whole test run down with it.
const isMainModule = argv[1] != null && import.meta.url === pathToFileURL(argv[1]).href;
if (isMainModule) {
  main().catch((e) => {
    stderr.write(`✗ ${e.message}\n`);
    exit(1);
  });
}
